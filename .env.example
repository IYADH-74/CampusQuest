# Production configuration for the API (SPRING_PROFILES_ACTIVE=prod). Never commit real values.

DATABASE_URL=jdbc:postgresql://db.example.internal:5432/campusquest
DATABASE_USERNAME=campusquest
DATABASE_PASSWORD=change-me

# Where the web client lives: used for CORS and for links in emails.
PUBLIC_BASE_URL=https://campusquest.example.edu
CORS_ALLOWED_ORIGINS=https://campusquest.example.edu

# RS256 signing keys (PEM). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Literal "\n" sequences are accepted when the PEM has to fit on one line.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# >= 32 random characters, e.g. `openssl rand -base64 48`. Rotating it invalidates outstanding email codes.
VERIFICATION_PEPPER=

# Comma-separated. Empty = any domain may self-register.
ALLOWED_EMAIL_DOMAINS=example.edu

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CampusQuest <no-reply@example.edu>

# First admin (invited by email on first start if no admin exists).
BOOTSTRAP_ADMIN_EMAIL=
